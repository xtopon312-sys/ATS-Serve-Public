{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ATS Windows release audit record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "platform", "arch", "channel", "version", "publishedAt", "sourceCommit", "installer", "blockmap", "metadata"],
  "properties": {
    "schemaVersion": {"const": 1},
    "platform": {"const": "windows"},
    "arch": {"const": "x64"},
    "channel": {"enum": ["stable", "beta"]},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-beta\\.(0|[1-9][0-9]*))?$"},
    "publishedAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "installer": {
      "allOf": [
        {"$ref": "#/definitions/file"},
        {"required": ["sha512"], "properties": {"filename": {"pattern": "^ATS-Serve-.*-win-x64\\.exe$"}}}
      ]
    },
    "blockmap": {"$ref": "#/definitions/auditFile"},
    "metadata": {"$ref": "#/definitions/auditFile"}
  },
  "definitions": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "path", "size", "sha256"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/v1/artifacts/windows/x64/"},
        "size": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sha512": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    },
    "auditFile": {"allOf": [{"$ref": "#/definitions/file"}, {"not": {"required": ["sha512"]}}]}
  }
}
